repeatDelay 50

Electricity
{
    flags useModel useBBox usePhysics useAlpha
    spawnFlags rgbComponentInterpolation

    life 70 90

    bounce 0.3 1.5

    origin 3 0 0

    origin2 180 -110 -5 200 110 5

    rgb
    {
        start 0.55 0.03 0.03
        end   0.25 0.01 0.01
    }

    alpha
    {
        start 0.75 0.55
    }

    size
    {
        start 2.8 3.6
        end 1.0 0.25
        flags linear
    }

    shaders
    [
        gfx/misc/judgementlineMAROON
    ]
}

Light
{
    spawnFlags rgbComponentInterpolation

    life 75

    rgb
    {
        start 0.45 0.02 0.02
    }

    alpha
    {
        start 0.35
    }
}

Particle
{
    spawnFlags rgbComponentInterpolation

    life 75

    origin 3 0 0

    rgb
    {
        start 0.5 0.03 0.03
    }

    alpha
    {
        start 0.25 0.4
    }

    size
    {
        start 1.5 2.3
    }

    shaders
    [
        gfx/misc/lightningflashRED
    ]
}
